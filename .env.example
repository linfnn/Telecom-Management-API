DB_NAME=QuanLyMangVienThong
DB_USER=sa
DB_PASSWORD=replace-with-your-sa-password
DB_HOST=127.0.0.1
DB_PORT=1433

IMPORT_EXPORT_FORMAT=qlmvt-json-import-export
IMPORT_EXPORT_VERSION=1
BACKUP_FORMAT=qlmvt-json-backup
BACKUP_VERSION=1

# OpenAI-compatible Chatbot provider (optional; keep the API key private)
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4o-mini
CHATBOT_TIMEOUT_SECONDS=30

# Comma-separated browser origins allowed to connect to Socket.IO.
SOCKETIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173